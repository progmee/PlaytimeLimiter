	},
	"license": "The MIT License",
	"icon": "assets/playtimelimiter/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.playtimelimiter.PlaytimeLimiter"
		]
	},
	"mixins": [],
	"depends": {
		"fabricloader": ">=0.15.0",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	}
}